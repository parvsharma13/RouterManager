# Copy to .env only if you're not using the recommended keychain-based setup.
# Prefer: npm run setup:credentials  (stores the admin password in macOS Keychain, not in a file)

ROUTER_BASE_URL=https://192.168.1.1
ROUTER_ADMIN_USERNAME=admin
# ROUTER_ADMIN_PASSWORD=            # fallback only — prefer: npm run setup:credentials
ROUTER_ALLOW_SELF_SIGNED=true

BACKEND_PORT=4001
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Off by default (unset). Only set this if you run the backend continuously and
# want it to periodically re-push pause/schedule policies to the router (self-heal after a
# router reboot/reset) without restarting the backend — see docs for the on-demand default.
# POLICY_SYNC_INTERVAL_MS=300000
